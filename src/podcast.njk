---
layout: base.njk
title: Podcast
description: The Social Media and Politics podcast is an interview-driven show with leading digital campaigners and academic experts.
permalink: /podcast/
---
{% include "page-title.njk" %}
<div class="wrapper page-section no-padding-top">
  <div class="page-content">
    <div class="podcast-embed">
      <iframe
        src="{{ site.podcast.embed }}"
        title="Social Media and Politics on Apple Podcasts"
        allow="autoplay *; encrypted-media *"
        sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
        loading="lazy"></iframe>
    </div>

    <p>{% set intro_parts = site.podcast_page.intro.split('Social Media and Politics Podcast') %}{% if intro_parts | length == 2 %}{{ intro_parts[0] }}<strong><a href="{{ site.podcast.site }}">Social Media and Politics Podcast</a></strong>{{ intro_parts[1] }}{% else %}{{ site.podcast_page.intro }}{% endif %}</p>
    {% for paragraph in site.podcast_page.body_paragraphs %}
    <p>{{ paragraph }}</p>
    {% endfor %}

    <ul class="podcast-links">
      <li><a href="{{ site.podcast.site }}">Podcast website</a></li>
      <li><a href="{{ site.podcast.apple }}">Apple Podcasts</a></li>
      <li><a href="{{ site.podcast.spotify }}">Spotify</a></li>
    </ul>
  </div>
</div>
