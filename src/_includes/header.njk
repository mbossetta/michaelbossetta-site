<header id="masthead" class="site-header sticky-header">
  <div class="site-branding">
    <div id="site-details">
      <p class="site-title"><a href="/">{{ site.name }}</a></p>
      <p class="site-description">Political Communication · Social Media · Democracy</p>
    </div>
  </div>
  <button class="nav-toggle menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
    <span class="menu-label">Menu</span>
  </button>
  <nav id="site-navigation" class="main-navigation" aria-label="Main">
    <ul id="primary-menu" class="menu nav-menu">
      {% for item in navigation %}
      <li{% if page.url == item.url %} class="current-menu-item"{% endif %}>
        <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      </li>
      {% endfor %}
    </ul>
  </nav>
</header>
