{% set page_title = og_title if og_title else (title ~ " - " ~ site.name if title else site.name ~ " | " ~ site.tagline) %}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@400;600;700&family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
<title>{% if title %}{{ title }} - {% endif %}{{ site.name }}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ page_title }}">
{% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% if site.headshot -%}
<meta property="og:image" content="{{ site.url }}{{ site.headshot }}">
{%- endif %}
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="{{ site.twitter_handle }}">
{% if description %}<meta name="twitter:description" content="{{ description }}">{% endif %}
