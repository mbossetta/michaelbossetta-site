{% for section in media | groupMediaByCategory %}
<section class="media-section">
  <h5>{{ section.category }}</h5>
  <ul>
    {% for item in section.items %}
    <li>
      {% if item.url %}
      <a href="{{ item.url }}"{% if item.url | externalLink %} target="_blank" rel="noopener noreferrer"{% endif %}><strong>{{ item.title }}</strong></a>
      {% else %}
      <strong>{{ item.title }}</strong>
      {% endif %}
      {% if item.description %} {{ item.description }} for{% endif %}
      {% if item.outlet %} <em>{{ item.outlet }}</em>{% endif %}{% if item.date %}, {{ item.date }}.{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endfor %}
