---
layout: base.njk
title: Home
og_title: Michael Bossetta | Social Media Expert | Podcaster
description: Michael Bossetta is an Associate Professor (Docent) at Lund University. His research explores the impact of social media on politics.
permalink: /
---
<div id="hero-section" class="relative">
  <div class="wrapper">
    <div class="section-content">
      <article class="hentry">
        <div class="entry-summary">
          <header class="entry-header">
            <h2 class="entry-title">
              <span class="first-name">Michael</span>
              <span class="last-name">Bossetta</span>
            </h2>
          </header>
          <div class="entry-description">
            <div class="separator"></div>
            <div class="entry-content small-description">{{ home.hero_intro | replace("Publications", '<a href="/publications/">Publications</a>') | replace("Podcast", '<a href="/podcast/">Podcast</a>') | safe }}</div>
          </div>
        </div>
        <div class="featured-image" style="background-image: url('{{ site.headshot }}');" role="img" aria-label="Portrait of Michael Bossetta"></div>
      </article>
    </div>
  </div>
</div>

<div id="about-section" class="relative page-section">
  <div class="wrapper">
    <article class="hentry">
      <header class="entry-header">
        <h2 class="entry-title">
          My <span>research</span> focuses on how <span>Politicians</span> and <span>Citizens</span> use <span>social media</span> during <span>Elections</span>
        </h2>
      </header>
      <div class="entry-content">
        <p>{{ home.about_body | replace('Contact page', '<a href="/contact/">Contact</a> page') | safe }}</p>
      </div>
      <div class="description">
        {{ home.podcast_summary }}
      </div>
    </article>
  </div>
</div>

<div id="latest-posts" class="relative featured-image-left">
  <div class="wrapper">
    <div class="section-content clearfix">
      <div class="posts-wrapper">
        <article class="hentry">
          <div class="entry-meta">
            <span class="posted-on"><a href="/2018/04/21/publications/"><time>April 21, 2018</time></a></span>
            <span class="post-categories"><a href="/publications/">Research</a></span>
          </div>
          <header class="entry-header">
            <h2 class="entry-title"><a href="/publications/">Publications</a></h2>
          </header>
          <div class="entry-content">{{ home.publications_teaser }}</div>
          <span class="read-more"><a href="/publications/">Read More</a></span>
        </article>
        <article class="hentry">
          <div class="entry-meta">
            <span class="posted-on"><a href="/2018/04/21/the-podcast/"><time>April 21, 2018</time></a></span>
            <span class="post-categories"><a href="/podcast/">Podcast</a></span>
          </div>
          <header class="entry-header">
            <h2 class="entry-title"><a href="/podcast/">The Podcast</a></h2>
          </header>
          <div class="entry-content">{{ home.podcast_teaser }}</div>
          <span class="read-more"><a href="/podcast/">Read More</a></span>
        </article>
      </div>
      <div class="featured-image-wrapper">
        <div class="featured-image" style="background-image: url('{{ site.hero_bg }}');">
          <p class="designation">{{ home.social_handle }}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="feedback-section" class="relative page-section">
  <div class="wrapper">
    <div class="section-content">
      <svg class="icon-quote" aria-hidden="true" viewBox="0 0 76 65" width="76" height="65"><path fill="currentColor" d="M0 32V0h32v32H16c0 8.8 7.2 16 16 16v16C14.3 64 0 49.7 0 32zm44 0V0h32v32H60c0 8.8 7.2 16 16 16v16C58.3 64 44 49.7 44 32z"/></svg>
      <div class="speaker-quote">
        <div class="entry-content">"{{ home.quote }}" — {{ home.quote_author }}</div>
      </div>
    </div>
  </div>
</div>

{% if home.youtube_id %}
<div id="video-wrapper" class="relative">
  <div class="wrapper">
    <div class="video-wrap">
      <iframe src="https://www.youtube.com/embed/{{ home.youtube_id }}" title="YouTube video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
    </div>
  </div>
</div>
{% endif %}
