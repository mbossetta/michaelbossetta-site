---
layout: base.njk
title: Home
og_title: Michael Bossetta | {{ site.tagline }}
description: Michael Bossetta is an {{ site.position }} at {{ site.institution }}. His research explores the impact of social media on politics.
permalink: /
hide_global_footer: true
---
<div id="hero-section" class="relative">
  <div class="wrapper">
    <div class="section-content">
      <article class="hentry">
        <div class="entry-summary">
          <header class="entry-header">
            <h2 class="entry-title">
              <span class="first-name">Michael</span>
              <span class="last-name">Bossetta</span>
            </h2>
          </header>
          <div class="entry-description">
            <div class="separator"></div>
            <div class="entry-content small-description">{{ home.hero_intro | replace("Publications", '<a href="/publications/">Publications</a>') | replace("Podcast", '<a href="/podcast/">Podcast</a>') | safe }}</div>
          </div>
        </div>
        <div class="featured-image">
          <img src="{{ site.headshot }}" alt="Portrait of Michael Bossetta" width="1200" height="1600" decoding="async">
        </div>
      </article>
    </div>
  </div>
</div>

<div id="about-section" class="relative page-section">
  <div class="wrapper">
    <article class="hentry">
      <header class="entry-header">
        <h2 class="entry-title">{{ home.about_headline | accentTerms(home.about_headline_accents) | safe }}</h2>
      </header>
      <div class="entry-content">
        <p class="research-description">{{ home.about_body | replace('Contact page', '<a href="/contact/">Contact</a> page') | safe }}</p>
      </div>
      <div class="description">
        {{ home.podcast_summary }}
      </div>
    </article>
  </div>
</div>

<footer class="site-footer">
  <div class="site-info">
    <div class="wrapper">
      <p>{{ site.name }}<br>{{ site.institution }}<br><a href="/contact/">Contact</a><br>Copyright © {{ "" | currentYear }}</p>
    </div>
  </div>
</footer>
